{
  "newFileLocation": "folder",
  "newFileFolderPath": "gitignore",
  "alwaysUpdateLinks": true,
  "showUnsupportedFiles": true,
  "userIgnoreFilters": [
    "public/"
  ],
  "propertiesInDocument": "visible",
  "pdfExportSettings": {
    "includeName": true,
    "pageSize": "Letter",
    "landscape": false,
    "margin": "0",
    "downscalePercent": 100
  },
  "mobileToolbarCommands": [
    "editor:configure-toolbar",
    "obsidian-footnotes:insert-autonumbered-footnote",
    "command-palette:open",
    "editor:paste",
    "editor:indent-list",
    "editor:unindent-list",
    "obsidian-heading-shifter:increase-heading",
    "obsidian-heading-shifter:decrease-heading",
    "editor:undo",
    "editor:redo",
    "editor:insert-wikilink",
    "editor:attach-file",
    "editor:set-heading",
    "editor:toggle-bold",
    "editor:toggle-italics",
    "editor:toggle-highlight",
    "editor:toggle-code",
    "editor:toggle-blockquote",
    "editor:insert-link",
    "editor:toggle-bullet-list",
    "editor:toggle-numbered-list",
    "editor:toggle-checklist-status",
    "editor:insert-table",
    "editor:context-menu"
  ],
  "vimMode": false,
  "attachmentFolderPath": "gitignore",
  "mobilePullAction": "command-palette:open",
  "showRibbon": true,
  "showInlineTitle": true
}